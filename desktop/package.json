{
  "name": "djachat",
  "productName": "DJAchat",
  "version": "1.0.2",
  "description": "Chat, voz, soundboard e tela para a galera",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "copiar-cliente": "node -e \"require('fs').cpSync('../client','client',{recursive:true})\"",
    "build": "npm run copiar-cliente && electron-builder --win nsis",
    "build:mac": "npm run copiar-cliente && electron-builder --mac dmg",
    "build:linux": "npm run copiar-cliente && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.djachat.app",
    "files": [
      "main.js",
      "preload.js",
      "client/**",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "DJAchat-Instalador.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "DJAchat",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
